            "buttonLabel": "ChatGPT에서 실행",
            "openInNewTab": true,
            "showSecurityNotice": true,
            "requireCompletionCheck": true,
            "practiceName": "Target Decision Stress Test",
            "practiceDescription": "Primary Target 선택이 확증편향에 빠지지 않았는지 반대편에서 검토합니다.",
            "estimatedMinutes": 10
          }
        },
        {
          "id": "d3l4-b08-form",
          "type": "input-form",
          "title": "Stress Test 결과",
          "visibility": "visible",
          "data": {
            "fields": [
