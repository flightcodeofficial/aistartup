          "type": "rich-text",
          "visibility": "visible",
          "data": {
            "markdown": "# Segment를 만들기 전에 Pattern부터 찾습니다\n\n아직 Segment를 만들지 않습니다. 자료 안의 반복 패턴만 먼저 찾습니다.",
            "emphasis": "normal"
          },
          "layout": { "width": "wide", "align": "left", "spacing": "medium" }
        },
        {
          "id": "d3l3-b03-context-form",
          "type": "input-form",
          "title": "Context 준비",
          "visibility": "visible",
          "data": {
            "fields": [
              {
                "id": "f1",
                "label": "Business Context",
                "kind": "long-text",
                "required": false,
                "importFrom": [
                  { "kind": "prior-artifact", "label": "2차시에서 가져오기", "artifactType": "business-idea", "artifactTitle": "2차시 — Business Context v0.2" }
