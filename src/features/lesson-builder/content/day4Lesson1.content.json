                ]
              },
              {
                "id": "f3",
                "label": "현재 가설 (Current Hypotheses)",
                "kind": "long-text",
                "required": false,
                "importFrom": [
                  { "kind": "prior-artifact", "label": "4차시에서 가져오기", "artifactType": "business-idea", "artifactTitle": "4차시 — Business Context v0.4", "sourceLabel": "현재 가설 (Current Hypotheses)" }
                ]
