            "markdown": "# 어디가 진짜 중요한 접점인지\n# 다시 검증합니다",
            "emphasis": "normal"
          },
          "layout": { "width": "wide", "align": "left", "spacing": "medium" }
        },
        {
          "id": "d4l4-b06-ref-form",
          "type": "input-form",
          "title": "이전 결과 참고",
          "visibility": "visible",
          "data": {
            "fields": [
              {
                "id": "f1",
                "label": "Current Journey Map / Prompt 1 결과 (참고용)",
