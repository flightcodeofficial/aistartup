        {
          "id": "d4l3-b06-title",
          "type": "rich-text",
          "visibility": "visible",
          "data": {
            "markdown": "# Actor Map을 실제 구매결정 구조 관점에서\n# 다시 검증합니다",
            "emphasis": "normal"
          },
          "layout": { "width": "wide", "align": "left", "spacing": "medium" }
        },
        {
          "id": "d4l3-b06-ref-form",
          "type": "input-form",
          "title": "이전 결과 참고",
          "visibility": "visible",
          "data": {
            "fields": [
              {
                "id": "f1",
                "label": "Actor Map / Prompt 1 결과 (참고용)",
                "kind": "long-text",
                "required": false,
                "importFrom": [
                  { "kind": "same-lesson", "label": "P03에서 가져오기", "sourceBlockId": "d4l3-b03-result-form" }
