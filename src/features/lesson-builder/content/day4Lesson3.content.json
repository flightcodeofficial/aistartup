              },
              {
                "id": "f2",
                "label": "ECP (참고용)",
                "kind": "long-text",
                "required": false,
                "importFrom": [
                  { "kind": "same-lesson", "label": "P03에서 가져오기", "sourceBlockId": "d4l3-b03-context-form", "sourceFieldIds": ["f1"] }
                ]
              },
              {
                "id": "f3",
                "label": "1순위 가치제안 (참고용)",
                "kind": "long-text",
                "required": false,
                "importFrom": [
                  { "kind": "same-lesson", "label": "P03에서 가져오기", "sourceBlockId": "d4l3-b03-context-form", "sourceFieldIds": ["f2"] }
                ]
              }
            ]
