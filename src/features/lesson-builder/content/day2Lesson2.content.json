        },
        {
          "id": "d2l2-b04-lens",
          "type": "infographic",
          "title": "필수 4 Lens",
          "visibility": "visible",
          "data": {
            "variant": "steps",
            "items": [
              {
                "label": "1. 상황",
                "description": "언제 문제가 생기는가?"
